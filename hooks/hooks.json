{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/pr-guard.mjs"], "timeout": 5 }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)_pull_request",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/pr-guard.mjs"], "timeout": 5 }
        ]
      }
    ]
  }
}
